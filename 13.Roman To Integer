class Solution:
    def romanToInt(self, s: str) -> int:
        roman = {"I" : 1,
        "V" : 5,
        "X" : 10,
        "L" : 50,
        "C" : 100,
        "D" : 500,
        "M" : 1000,
        }

        total = 0
        next_value = 0

        for i in range(len(s)-1, -1, -1):
            current_char = s[i]
            current_value = roman[current_char]
            if current_value < next_value:
                total -= current_value
            else:
                total += current_value
            next_value = current_value

        
        return total

