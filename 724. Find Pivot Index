class Solution:
    def pivotIndex(self, nums: List[int]) -> int:
        for i in range(1,len(nums)):
            nums[i] = nums[i-1] + nums[i]

        for i in range(len(nums)):
            if i == 0:
                if (nums[len(nums)-1] - nums[i]) == 0:
                    return 0
             
            elif (i > 0) and (i < len(nums)-1):
                if nums[i-1] == (nums[len(nums)-1] - nums[i]):
                    return i
                
            elif (i == len(nums)-1):
                if nums[i-1]==0:
                    return i
        return -1
                
            
        
