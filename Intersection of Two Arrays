class Solution:
    def intersection(self, nums1: List[int], nums2: List[int]) -> List[int]:
        hash_map1 ={}
        hash_map2 ={}
        ans =[]

        for num in nums1:
            hash_map1[num] = True
        
        for num in nums2:
            if num in hash_map1:
                if num not in hash_map2:
                    ans.append(num)
                    hash_map2[num] = True
        return ans
