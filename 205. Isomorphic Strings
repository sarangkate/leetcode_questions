class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:
        hash_map = {}
        hash_map2 = {}
        for i in range(len(s)):
            if s[i] in hash_map:
                if hash_map[s[i]] != t[i]:
                    return False
            else:
                hash_map[s[i]] = t[i]

        for i in range(len(t)):
            if t[i] in hash_map2:
                if hash_map2[t[i]] != s[i]:
                    return False
            else:
                hash_map2[t[i]] = s[i]
       
        return True
