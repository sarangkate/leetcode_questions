class Solution:
    def backspaceCompare(self, s: str, t: str) -> bool:
        stack_1 = []
        stack_2 = []
        for i in range(len(s)):
            if s[i] != '#':
                stack_1.append(s[i])
            else:
                if stack_1:
                    stack_1.pop()
        for i in range(len(t)):
            if t[i] != '#':
                stack_2.append(t[i])
            else:
                if stack_2:
                    stack_2.pop()
        return stack_1 == stack_2
